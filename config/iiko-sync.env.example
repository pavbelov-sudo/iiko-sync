# Конфигурация запуска iiko-sync для run.sh.
#
# Скопируйте этот файл в config/iiko-sync.env (без .example) и отредактируйте под себя -
# run.sh подхватывает именно config/iiko-sync.env, если он существует. Файл - обычный
# shell-скрипт (строки VAR=значение), поэтому значения с пробелами и спецсимволами
# берите в одинарные кавычки.

### Память JVM (см. также JVM_EXTRA_OPTS ниже для любых дополнительных флагов) ###
JVM_XMS=256m
JVM_XMX=1024m

### Режим работы приложения (см. README.md) ###
MODE=api

### --- MODE=api: HTTP(S)-шлюз --- ###
PORT=8080

# Раскомментируйте для HTTPS (порт по умолчанию меняется на 8443, если PORT не задан отдельно):
# TLS_ENABLED=true
# TLS_KEYSTORE=config/keystore.p12
# TLS_KEYSTORE_PASSWORD='пароль_хранилища'

# Раскомментируйте для обязательной аутентификации клиента по сертификату (mTLS).
# Требует TLS_ENABLED=true. Список разрешённых CommonName живёт в отдельном файле
# (config/allowed-cns.txt) - его можно редактировать прямо на сервере, изменения
# подхватываются на лету, без перезапуска приложения (см. README.md).
# TLS_CLIENT_AUTH_ENABLED=true
# TLS_CLIENT_TRUSTSTORE=config/truststore.p12
# TLS_CLIENT_TRUSTSTORE_PASSWORD='пароль_truststore'
# TLS_CLIENT_ALLOWED_CNS_FILE=config/allowed-cns.txt

### --- MODE=sync: прежний пакетный режим (выгрузка в SQLite) --- ###
# IIKO_API_LOGIN='ваш_apiLogin'
# IIKO_APP_ID='ваш_appId'
# IIKO_CLIENT_SECRET='ваш_clientSecret'
# IIKO_DB=data/iiko.db
# SYNC_INTERVAL_MIN=60

### Любые дополнительные JVM-флаги (не обязательно) ###
# Добавляются как есть в командную строку java, например для прокси или нестандартной
# кодировки. По умолчанию run.sh уже передаёт -Dfile.encoding=UTF-8.
JVM_EXTRA_OPTS=""
